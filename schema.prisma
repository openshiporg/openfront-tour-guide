  refundApprovalThresholdCents Int?     @default(10000)
  waitlistOfferHours           Int?     @default(12)
  taxBps                       Int?     @default(0)
  settingsKey                  String   @unique @default("operator")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @default(now()) @updatedAt
}

model AuditEvent {
  id         String   @id @default(cuid())
  actor      User?    @relation("AuditEvent_actor", fields: [actorId], references: [id])
  actorId    String?  @map("actor")
  action     String   @default("")
  targetList String   @default("")
  targetId   String   @default("")
  before     Json?
  after      Json?
  reason     String   @default("")
  requestId  String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([actorId])
  @@index([targetId])
  @@index([requestId])
}

model PromoCode {
  id            String                     @id @default(cuid())
  code          String                     @unique @default("")
  discountType  PromoCodeDiscountTypeType? @default(percent_bps)
  value         Int?                       @default(0)
  maxUses       Int?
  usedCount     Int?                       @default(0)
  perOrderLimit Int?
  startsAt      DateTime?
  endsAt        DateTime?
  status        PromoCodeStatusType?       @default(active)
  tours         Tour[]                     @relation("PromoCode_tours")
  redemptions   PromoRedemption[]          @relation("PromoRedemption_promoCode")
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @default(now()) @updatedAt
}

model PromoRedemption {
  id           String                     @id @default(cuid())
  promoCode    PromoCode?                 @relation("PromoRedemption_promoCode", fields: [promoCodeId], references: [id])
  promoCodeId  String?                    @map("promoCode")
  booking      Booking?                   @relation("PromoRedemption_booking", fields: [bookingId], references: [id])
  bookingId    String?                    @map("booking")
  holdId       String                     @default("")
  amountCents  Int?                       @default(0)
  currencyCode String                     @default("USD")
  status       PromoRedemptionStatusType? @default(reserved)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @default(now()) @updatedAt

  @@index([promoCodeId])
  @@index([bookingId])
  @@index([holdId])
}

model PaymentProvider {
  id                           String           @id @default(cuid())
  name                         String           @default("")
  code                         String           @unique @default("")
  isInstalled                  Boolean          @default(true)
  credentials                  Json?            @default("{}")
  metadata                     Json?            @default("{}")
  createPaymentFunction        String           @default("")
  capturePaymentFunction       String           @default("")
  refundPaymentFunction        String           @default("")
  getPaymentStatusFunction     String           @default("")
  generatePaymentLinkFunction  String           @default("")
  handleWebhookFunction        String           @default("")
  sessions                     PaymentSession[] @relation("PaymentSession_paymentProvider")
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @default(now()) @updatedAt
  from_Payment_paymentProvider Payment[]        @relation("Payment_paymentProvider")
}

model PaymentCollection {
  id               String                            @id @default(cuid())
  description      PaymentCollectionDescriptionType? @default(default)
  amount           Int
  authorizedAmount Int?                              @default(0)
  refundedAmount   Int?                              @default(0)
  metadata         Json?
  paymentSessions  PaymentSession[]                  @relation("PaymentSession_paymentCollection")
  payments         Payment[]                         @relation("Payment_paymentCollection")
  booking          Booking?                          @relation("Booking_paymentCollection")
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @default(now()) @updatedAt
}

model PaymentSession {
  id                  String             @id @default(cuid())
  isSelected          Boolean            @default(false)
  isInitiated         Boolean            @default(false)
  amount              Int
  data                Json?              @default("{}")
  idempotencyKey      String             @unique @default("")
  paymentCollection   PaymentCollection? @relation("PaymentSession_paymentCollection", fields: [paymentCollectionId], references: [id])
  paymentCollectionId String?            @map("paymentCollection")
  paymentProvider     PaymentProvider?   @relation("PaymentSession_paymentProvider", fields: [paymentProviderId], references: [id])
  paymentProviderId   String?            @map("paymentProvider")
  paymentAuthorizedAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt

  @@index([paymentCollectionId])
  @@index([paymentProviderId])
}

model Payment {
  id                               String                @id @default(cuid())
  idempotencyKey                   String                @unique @default("")
  reservedAt                       DateTime?
  refundedAmount                   Int?                  @default(0)
  amount                           Int
  data                             Json?
  currencyCode                     String                @default("USD")
  status                           String                @default("pending")
  paymentMethod                    String?               @default("credit_card")
  paymentProvider                  PaymentProvider?      @relation("Payment_paymentProvider", fields: [paymentProviderId], references: [id])
  paymentProviderId                String?               @map("paymentProvider")
  providerPaymentId                String                @default("")
  cardLast4                        String                @default("")
  cardBrand                        String                @default("")
  tipAmount                        Int?                  @default(0)
  isSplitPayment                   Boolean               @default(false)
  splitPaymentIndex                Int?
  splitTotal                       Int?
  processedAt                      DateTime?
  errorMessage                     String                @default("")
  notes                            String                @default("")
  order                            Booking?              @relation("Payment_order", fields: [orderId], references: [id])
  orderId                          String?               @map("order")
  paymentCollection                PaymentCollection?    @relation("Payment_paymentCollection", fields: [paymentCollectionId], references: [id])
  paymentCollectionId              String?               @map("paymentCollection")
  processedBy                      User?                 @relation("Payment_processedBy", fields: [processedById], references: [id])
  processedById                    String?               @map("processedBy")
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @default(now()) @updatedAt
  from_Refund_payment              Refund[]              @relation("Refund_payment")
  from_PaymentWebhookEvent_payment PaymentWebhookEvent[] @relation("PaymentWebhookEvent_payment")

  @@index([paymentProviderId])
  @@index([orderId])
  @@index([paymentCollectionId])
  @@index([processedById])
}

model Refund {
  id               String    @id @default(cuid())
  idempotencyKey   String    @unique @default("")
  amount           Int
  currencyCode     String    @default("")
  status           String    @default("processing")
  reason           String    @default("")
  providerRefundId String    @default("")
  providerData     Json?
  processedAt      DateTime?
  payment          Payment?  @relation("Refund_payment", fields: [paymentId], references: [id])
  paymentId        String?   @map("payment")
  order            Booking?  @relation("Refund_order", fields: [orderId], references: [id])
  orderId          String?   @map("order")
  requestedBy      User?     @relation("Refund_requestedBy", fields: [requestedById], references: [id])
  requestedById    String?   @map("requestedBy")
  approvedBy       User?     @relation("Refund_approvedBy", fields: [approvedById], references: [id])
  approvedById     String?   @map("approvedBy")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([paymentId])
  @@index([orderId])
  @@index([requestedById])
  @@index([approvedById])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  eventKey        String    @unique @default("")
  providerCode    String    @default("")
  providerEventId String    @default("")
  eventType       String    @default("")
  status          String?   @default("received")
  payload         Json?
  rawBody         String    @default("")
  error           String    @default("")
  attempts        Int?      @default(0)
  receivedAt      DateTime? @default(now())
  processedAt     DateTime?
  payment         Payment?  @relation("PaymentWebhookEvent_payment", fields: [paymentId], references: [id])
  paymentId       String?   @map("payment")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([providerCode])
  @@index([providerEventId])
  @@index([eventType])
  @@index([receivedAt])
  @@index([paymentId])
}

model IdempotencyKey {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique @default("")
  requestMethod  String    @default("")
  requestParams  Json?
  requestPath    String    @default("")
  responseCode   Int?
  responseBody   Json?
  recoveryPoint  String    @default("started")
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

model ManagerApproval {
  id                 String    @id @default(cuid())
  actionType         String
  targetId           String    @default("")
  reason             String    @default("")
  amount             Int?
  requestFingerprint String    @default("")
  requestPayload     Json?
  status             String    @default("pending")
  requestedAt        DateTime? @default(now())
  approvedAt         DateTime?
  consumedAt         DateTime?
  expiresAt          DateTime
  consumedEntityType String    @default("")
  consumedEntityId   String    @default("")
  requestedBy        User?     @relation("ManagerApproval_requestedBy", fields: [requestedById], references: [id])
  requestedById      String?   @map("requestedBy")
  approvedBy         User?     @relation("ManagerApproval_approvedBy", fields: [approvedById], references: [id])
  approvedById       String?   @map("approvedBy")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([actionType])
  @@index([targetId])
  @@index([status])
  @@index([requestedAt])
  @@index([expiresAt])
  @@index([requestedById])
  @@index([approvedById])
}

model GiftCard {
  id             String                @id @default(cuid())
  codeHash       String                @unique @default("")
  last4          String                @default("")
  status         GiftCardStatusType?   @default(active)
  initialCents   Int?                  @default(0)
  balanceCents   Int?                  @default(0)
  currencyCode   String                @default("USD")
  expiresAt      DateTime?
  fundedBy       GiftCardFundedByType? @default(cash)
  recipientName  String                @default("")
  recipientEmail String                @default("")
  note           String                @default("")
  issuedById     String                @default("")
  replacesId     String                @default("")
  entries        GiftCardEntry[]       @relation("GiftCardEntry_giftCard")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt

  @@index([recipientEmail])
}

model GiftCardEntry {
  id                String                 @id @default(cuid())
  giftCard          GiftCard?              @relation("GiftCardEntry_giftCard", fields: [giftCardId], references: [id])
  giftCardId        String?                @map("giftCard")
  kind              GiftCardEntryKindType? @default(issue)
  amountCents       Int
  balanceAfterCents Int?                   @default(0)
  bookingId         String                 @default("")
  bookingRef        String                 @default("")
  paymentId         String                 @default("")
  idempotencyKey    String                 @unique @default("")
  reason            String                 @default("")
  actorId           String                 @default("")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt

  @@index([giftCardId])
  @@index([bookingId])
}

